<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="info" monitorInterval="30">

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level %c{1} - %msg%n"/>
        </Console>

        <RollingFile
            name="File"
            fileName="logs/automation.log"
            filePattern="logs/automation-%d{yyyy-MM-dd}-%i.log"
            append="true"
            createOnDemand="true">

            <PatternLayout>
                <Pattern>
                    %d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %c{1} - %msg%n
                </Pattern>
            </PatternLayout>

            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>

            <DefaultRolloverStrategy max="10"/>

        </RollingFile>

    </Appenders>

    <Loggers>

        <Logger name="org.testng" level="DEBUG"/>
        <Logger name="com.aventstack" level="DEBUG"/>
        <Logger name="com" level="DEBUG"/>
        <Logger name="org.apache.logging.log4j" level="DEBUG"/>

        <Root level="DEBUG">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>

    </Loggers>

</Configuration>
